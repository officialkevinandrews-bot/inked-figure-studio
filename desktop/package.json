{
  "name": "mangakadesk-desktop",
  "version": "1.0.0",
  "description": "MangakaDesk — Manga & Webtoon Creation Studio for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win zip",
    "dist:win:nsis": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mangakadesk.desktop",
    "productName": "MangakaDesk",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/**"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MangakaDesk-Windows-v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MangakaDesk"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  }
}
